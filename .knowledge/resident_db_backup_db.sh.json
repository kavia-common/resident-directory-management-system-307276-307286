{"is_source_file": true, "format": "bash", "description": "A shell script to automatically detect and back up various types of databases (SQLite, PostgreSQL, MySQL, MongoDB). It performs checks for each database type and creates backups accordingly, with specific handling for different configurations and user credentials.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo", "mysqladmin", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "cp \"${DB_NAME}\" \"database_backup.db\"", "sudo -u postgres ${PG_BIN}/pg_isready -p ${DB_PORT}", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD}", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD}", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup", "SQLite", "PostgreSQL", "MySQL", "MongoDB", "database detection script", "database backup automation"], "state": 2, "file_id": 2, "knowledge_revision": 14, "git_revision": "f7a5df7ad9a1b1d94283eb6ddb39ef0cf9a3e470", "hash": "7af9aa35fa4940f934d83f6e2621b732", "format-version": 4, "code-base-name": "resident_db", "filename": "resident_db/backup_db.sh", "revision_history": [{"14": "f7a5df7ad9a1b1d94283eb6ddb39ef0cf9a3e470"}]}